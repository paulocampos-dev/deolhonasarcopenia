<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
<%- include('partials/head', { title: 'De Olho Na Sarcopenia - Home', description: 'Entenda a sarcopenia, descubra exercícios seguros e informações baseadas em evidências para manter força e qualidade de vida no envelhecimento.' }) %>
</head>
<body class="antialiased min-h-screen flex flex-col text-on-background">
<%- include('partials/header', { activePage: 'home', settings: settings }) %>
<main class="flex-grow">
<!-- Hero Section -->
<section class="w-full px-gutter md:px-gutter max-w-container-max mx-auto pt-stack-lg pb-stack-lg flex flex-col md:flex-row items-center gap-stack-lg mt-8">
<div class="flex-1 space-y-6">
<div class="inline-flex items-center gap-2 bg-surface-container-high px-4 py-2 rounded-full border border-secondary">
<span class="material-symbols-outlined text-secondary text-sm icon-fill">info</span>
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"><%= page.eyebrow %></span>
</div>
<h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-tertiary">
                    <%= page.h1Prefix %> <span class="text-tertiary relative inline-block"><%= page.h1Highlight %><svg class="absolute w-full h-3 -bottom-1 left-0 text-secondary" preserveAspectRatio="none" viewBox="0 0 100 20"><path d="M0,10 Q50,20 100,10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="8"></path></svg></span>
</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl"><%= page.heroParagraph %></p>
<div class="pt-4 flex flex-col sm:flex-row gap-4">
<a class="bg-primary text-on-primary font-label-lg text-label-lg px-8 py-4 rounded-full hover:bg-primary/90 focus:ring-4 focus:ring-primary-container active:scale-95 transition-all duration-200 shadow-sm flex items-center justify-center gap-2 group" href="/exercicios/">
                        <%= page.ctaPrimaryLabel %>
                        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
</a>
<a class="bg-surface text-secondary border-2 border-secondary font-label-lg text-label-lg px-8 py-4 rounded-full hover:bg-secondary/10 focus:ring-4 focus:ring-secondary/20 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2" href="/contato/">
                        <%= page.ctaSecondaryLabel %>
                    </a>
</div>
</div>
<div class="flex-1 relative w-full aspect-square md:aspect-auto md:h-[600px] rounded-3xl overflow-hidden border border-outline-variant shadow-sm bg-surface-container-lowest">
<img alt="<%= page.heroImageAlt %>" class="w-full h-full object-cover" src="<%= page.heroImage %>"/>
<div class="absolute bottom-6 left-6 right-6 backdrop-blur-md p-4 rounded-2xl border border-secondary flex items-center gap-4 shadow-sm bg-surface">
<div class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-white icon-fill">verified</span>
</div>
<div>
<p class="font-label-lg text-label-lg text-on-surface"><%= page.badgeTitle %></p>
<p class="font-body-md text-body-md text-on-surface-variant"><%= page.badgeSubtitle %></p>
</div>
</div>
</div>
</section>
<!-- About / USP Roots Section -->
<section class="bg-surface py-stack-lg">
<div class="px-gutter max-w-container-max mx-auto flex flex-col md:flex-row gap-stack-lg items-center">
<div class="flex-1 relative w-full max-w-md mx-auto aspect-[4/3] md:aspect-square">
<div class="absolute inset-0 bg-primary rounded-3xl -translate-x-4 translate-y-4"></div>
<img alt="<%= page.aboutImageAlt %>" class="w-full h-full object-cover rounded-3xl relative z-10 border border-outline-variant" src="<%= page.aboutImage %>"/>
</div>
<div class="flex-1 space-y-6">
<h2 class="font-headline-md text-headline-md text-tertiary"><%= page.aboutHeading %></h2>
<p class="font-body-lg text-body-lg text-on-surface-variant"><%= page.aboutParagraph1 %></p>
<p class="font-body-md text-body-md text-on-surface-variant"><%= page.aboutParagraph2 %></p>
</div>
</div>
</section>
<!-- Quick Links Bento Grid -->
<section class="px-gutter py-stack-lg max-w-container-max mx-auto rounded-3xl mt-8 mb-16 border-secondary/30">
<div class="text-center mb-12">
<h2 class="font-headline-md text-headline-md text-tertiary mb-4"><%= page.helpHeading %></h2>
<p class="font-body-md text-body-md text-on-surface-variant max-w-2xl mx-auto"><%= page.helpSubheading %></p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
<!-- Card 1 -->
<a class="group block relative bg-surface rounded-2xl border border-secondary/50 p-8 hover:bg-secondary/5 hover:border-secondary transition-all duration-300 shadow-sm hover:shadow-md h-full flex flex-col justify-between" href="/blog/">
<div>
<div class="w-14 h-14 bg-secondary/20 text-secondary rounded-xl flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-white transition-colors">
<span class="material-symbols-outlined text-3xl icon-fill">local_library</span>
</div>
<h3 class="font-headline-md text-headline-md text-tertiary mb-3 text-xl"><%= page.card1Title %></h3>
<p class="font-body-md text-body-md text-on-surface-variant"><%= page.card1Description %></p>
</div>
<div class="mt-8 flex items-center font-label-sm text-label-sm text-primary">
<span><%= page.card1Cta %></span>
<span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform text-sm">arrow_forward</span>
</div>
</a>
<!-- Card 2 -->
<a class="group block relative bg-surface rounded-2xl border border-secondary/50 p-8 hover:bg-secondary/5 hover:border-secondary transition-all duration-300 shadow-sm hover:shadow-md h-full flex flex-col justify-between md:col-span-2 lg:col-span-1" href="/exercicios/">
<div>
<div class="w-14 h-14 bg-primary/20 text-primary rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors">
<span class="material-symbols-outlined text-3xl icon-fill">fitness_center</span>
</div>
<h3 class="font-headline-md text-headline-md text-tertiary mb-3 text-xl"><%= page.card2Title %></h3>
<p class="font-body-md text-body-md text-on-surface-variant"><%= page.card2Description %></p>
</div>
<div class="mt-8 flex items-center font-label-sm text-label-sm text-primary">
<span><%= page.card2Cta %></span>
<span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform text-sm">arrow_forward</span>
</div>
</a>
<!-- Card 3 -->
<a class="group block relative bg-surface rounded-2xl border border-secondary/50 p-8 hover:bg-secondary/5 hover:border-secondary transition-all duration-300 shadow-sm hover:shadow-md h-full flex flex-col justify-between md:col-span-3 lg:col-span-1" href="/contato/">
<div>
<div class="w-14 h-14 bg-secondary/20 text-secondary rounded-xl flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-white transition-colors">
<span class="material-symbols-outlined text-3xl icon-fill">forum</span>
</div>
<h3 class="font-headline-md text-headline-md text-tertiary mb-3 text-xl"><%= page.card3Title %></h3>
<p class="font-body-md text-body-md text-on-surface-variant"><%= page.card3Description %></p>
</div>
<div class="mt-8 flex items-center font-label-sm text-label-sm text-primary">
<span><%= page.card3Cta %></span>
<span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform text-sm">arrow_forward</span>
</div>
</a>
</div>
</section>
</main>
<%- include('partials/footer', { brandText: settings.brandText, footerOrgLine: settings.footerOrgLine, contactEmail: settings.contactEmail, instagramUrl: settings.instagramUrl, instagramLabel: settings.instagramLabel }) %>
</body>
</html>
