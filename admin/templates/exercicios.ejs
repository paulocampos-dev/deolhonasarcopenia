<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
<%- include('partials/head', { title: 'Exercícios - De Olho Na Sarcopenia', description: 'Exercícios seguros e recomendados para prevenir e tratar a sarcopenia, com passo a passo pensado para a terceira idade.' }) %>
</head>
<body class="bg-background text-on-background antialiased min-h-screen flex flex-col">
<%- include('partials/header', { activePage: 'exercicios', brandText: settings.brandText, logoImage: settings.logoImage }) %>
<main class="flex-grow flex flex-col items-center w-full px-container-padding-mobile lg:px-container-padding-desktop py-stack-gap max-w-[1200px] mx-auto gap-stack-gap">
<!-- Page Header -->
<section class="w-full text-center max-w-3xl mx-auto space-y-unit">
<h1 class="font-display-lg text-display-lg text-primary"><%= page.heading %></h1>
<div class="bg-error-container text-on-error-container p-4 rounded-lg flex items-start gap-4 text-left border-l-4 border-golden-orange">
<span class="material-symbols-outlined mt-1 text-golden-orange icon-fill">warning</span>
<p class="font-body-md text-body-md">
<strong>Atenção:</strong> <%= page.warningText %>
                </p>
</div>
</section>
<!-- Exercise Grid -->
<section class="w-full grid grid-cols-1 md:grid-cols-2 gap-gutter">
<% exercises.forEach(function (ex) { %>
<article class="bg-surface-container-lowest border border-primary-container rounded-xl overflow-hidden shadow-sm flex flex-col">
<div class="w-full h-48 bg-surface-container-high relative">
<img alt="<%= ex.imageAlt %>" class="object-cover w-full h-full" src="<%= ex.image %>"/>
</div>
<div class="p-6 flex flex-col flex-grow bg-white">
<h2 class="font-headline-md text-headline-md text-tertiary mb-4"><%= ex.title %></h2>
<div class="mb-6 bg-golden-orange p-4 rounded-lg flex items-center gap-4 border border-golden-orange">
<div class="text-white font-label-md flex-grow">
<strong><%= ex.itemsLabel %></strong>
</div>
<div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-golden-orange border-2 border-white">
<span class="material-symbols-outlined icon-fill"><%= ex.itemsIcon %></span>
</div>
</div>
<ol class="space-y-4 font-body-md text-body-md text-on-surface flex-grow">
<% ex.steps.forEach(function (step, i) { %>
<li class="flex gap-4">
<span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center flex-shrink-0 font-bold"><%= i + 1 %></span>
<span><%= step %></span>
</li>
<% }) %>
</ol>
</div>
</article>
<% }) %>
</section>
</main>
<%- include('partials/footer', { brandText: settings.brandText, footerOrgLine: settings.footerOrgLine, contactEmail: settings.contactEmail, instagramUrl: settings.instagramUrl, instagramLabel: settings.instagramLabel }) %>
</body>
</html>
