<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
<%- include('partials/head', { title: post.title + ' - De Olho Na Sarcopenia', description: post.excerpt }) %>
<style>
    .post-body h2 { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; font-size: 24px; color: #75070c; margin-top: 1.5em; margin-bottom: 0.5em; }
    .post-body h3 { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; font-size: 20px; color: #75070c; margin-top: 1.25em; margin-bottom: 0.5em; }
    .post-body p { margin-bottom: 1.25em; }
    .post-body a { color: #243f20; text-decoration: underline; }
    .post-body img { border-radius: 0.75rem; margin: 1.5em 0; max-width: 100%; height: auto; }
    .post-body ul, .post-body ol { margin: 1em 0 1.25em 1.5em; }
    .post-body li { margin-bottom: 0.5em; }
    .post-body strong { font-weight: 700; }
</style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">
<%- include('partials/header', { activePage: 'blog', brandText: settings.brandText, logoImage: settings.logoImage }) %>
<main class="flex-grow w-full max-w-3xl mx-auto px-container-padding-mobile lg:px-container-padding-desktop py-12">
<a class="inline-flex items-center gap-2 text-primary font-label-lg text-label-lg mb-8 hover:underline" href="/blog/">
<span class="material-symbols-outlined">arrow_back</span>
                Voltar para o Blog
            </a>
<article>
<header class="mb-8">
<h1 class="font-headline-lg text-headline-lg md:font-display-lg md:text-display-lg text-tertiary mb-4"><%= post.title %></h1>
<div class="flex items-center gap-3 font-body-md text-body-md text-on-surface-variant">
<span><%= post.author %></span>
<span aria-hidden="true">·</span>
<time datetime="<%= post.date %>"><%= new Date(post.date + 'T00:00:00').toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %></time>
</div>
</header>
<div class="w-full aspect-[16/9] rounded-xl overflow-hidden border border-outline-variant mb-8">
<img alt="<%= post.coverImageAlt %>" class="w-full h-full object-cover" src="<%= post.coverImage %>"/>
</div>
<div class="post-body font-body-md text-body-md text-on-surface"><%- post.bodyHtml %></div>
</article>

<section class="mt-16 pt-8 border-t border-outline-variant" id="comentarios">
<h2 class="font-headline-md text-headline-md text-tertiary mb-6">Comentários</h2>
<div class="flex flex-col gap-4 mb-10" data-comments-list>
<p class="font-body-md text-body-md text-on-surface-variant" data-comments-loading>Carregando comentários...</p>
</div>

<div class="bg-surface-container-low rounded-xl p-6 lg:p-8 border border-outline-variant">
<h3 class="font-headline-md text-headline-md text-tertiary mb-4" style="font-size: 20px;">Deixe um comentário</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6">Nome e contato são opcionais. O contato não é exibido no site - é só para a equipe responder, se você quiser.</p>
<form class="flex flex-col gap-4" data-comment-form>
<input aria-hidden="true" autocomplete="off" data-comment-honeypot name="website" style="position:absolute; left:-9999px;" tabindex="-1" type="text"/>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div class="flex flex-col gap-2">
<label class="font-label-lg text-label-lg text-on-surface" for="comment-author">Nome (opcional)</label>
<input class="min-h-touch-target-min w-full bg-surface-container-lowest border-2 border-transparent text-on-surface rounded-lg px-4 py-3 focus:outline-none focus:border-primary-container transition-colors font-body-md" id="comment-author" maxlength="100" name="authorName" placeholder="Como você quer ser chamado?" type="text"/>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-lg text-label-lg text-on-surface" for="comment-contact">Contato (opcional)</label>
<input class="min-h-touch-target-min w-full bg-surface-container-lowest border-2 border-transparent text-on-surface rounded-lg px-4 py-3 focus:outline-none focus:border-primary-container transition-colors font-body-md" id="comment-contact" maxlength="200" name="authorContact" placeholder="E-mail ou telefone" type="text"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-lg text-label-lg text-on-surface" for="comment-body">Comentário</label>
<textarea class="w-full bg-surface-container-lowest border-2 border-transparent text-on-surface rounded-lg px-4 py-3 focus:outline-none focus:border-primary-container transition-colors font-body-md resize-y" id="comment-body" maxlength="2000" name="body" required rows="4"></textarea>
</div>
<div class="flex items-center gap-4">
<button class="min-h-touch-target-min px-8 py-3 bg-primary text-on-primary font-label-lg text-label-lg rounded-full hover:bg-primary/90 transition-colors" type="submit">
                        Enviar Comentário
                    </button>
<p class="font-body-md text-body-md" data-comment-status></p>
</div>
</form>
</div>
</section>
</main>
<%- include('partials/footer', { brandText: settings.brandText, footerOrgLine: settings.footerOrgLine, contactEmail: settings.contactEmail, instagramUrl: settings.instagramUrl, instagramLabel: settings.instagramLabel }) %>
<script>
(function () {
    var slug = <%- JSON.stringify(post.slug) %>;
    var apiUrl = '/api/comentarios/' + encodeURIComponent(slug);
    var list = document.querySelector('[data-comments-list]');
    var form = document.querySelector('[data-comment-form]');
    var status = document.querySelector('[data-comment-status]');

    function formatDate(iso) {
        try {
            return new Date(iso.replace(' ', 'T') + 'Z').toLocaleDateString('pt-BR', {
                day: '2-digit', month: 'long', year: 'numeric',
            });
        } catch (e) {
            return '';
        }
    }

    function postComment(payload, cb) {
        fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
        })
            .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
            .then(function (result) { cb(null, result); })
            .catch(function (err) { cb(err); });
    }

    function buildReplyForm(parentId, onPosted) {
        var wrap = document.createElement('div');
        wrap.className = 'mt-3 bg-surface-container-low rounded-lg p-4';
        var innerForm = document.createElement('form');
        innerForm.className = 'flex flex-col gap-3';

        var honeypot = document.createElement('input');
        honeypot.type = 'text';
        honeypot.name = 'website';
        honeypot.tabIndex = -1;
        honeypot.autocomplete = 'off';
        honeypot.setAttribute('aria-hidden', 'true');
        honeypot.style.position = 'absolute';
        honeypot.style.left = '-9999px';

        var fieldClass = 'min-h-[44px] w-full bg-surface-container-lowest border-2 border-transparent text-on-surface rounded-lg px-3 py-2 focus:outline-none focus:border-primary-container font-body-md text-sm';

        var row = document.createElement('div');
        row.className = 'grid grid-cols-1 sm:grid-cols-2 gap-3';
        var nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.placeholder = 'Nome (opcional)';
        nameInput.maxLength = 100;
        nameInput.className = fieldClass;
        var contactInput = document.createElement('input');
        contactInput.type = 'text';
        contactInput.placeholder = 'Contato (opcional)';
        contactInput.maxLength = 200;
        contactInput.className = fieldClass;
        row.appendChild(nameInput);
        row.appendChild(contactInput);

        var bodyInput = document.createElement('textarea');
        bodyInput.required = true;
        bodyInput.maxLength = 2000;
        bodyInput.rows = 3;
        bodyInput.placeholder = 'Escreva sua resposta...';
        bodyInput.className = fieldClass + ' resize-y';

        var actionsRow = document.createElement('div');
        actionsRow.className = 'flex items-center gap-3';
        var submitBtn = document.createElement('button');
        submitBtn.type = 'submit';
        submitBtn.textContent = 'Enviar Resposta';
        submitBtn.className = 'min-h-[40px] px-5 bg-primary text-on-primary font-label-lg text-sm rounded-full hover:bg-primary/90 transition-colors';
        var replyStatus = document.createElement('span');
        replyStatus.className = 'font-body-md text-sm text-on-surface-variant';
        actionsRow.appendChild(submitBtn);
        actionsRow.appendChild(replyStatus);

        innerForm.appendChild(honeypot);
        innerForm.appendChild(row);
        innerForm.appendChild(bodyInput);
        innerForm.appendChild(actionsRow);
        wrap.appendChild(innerForm);

        innerForm.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!bodyInput.value.trim()) return;
            replyStatus.textContent = 'Enviando...';
            postComment(
                {
                    authorName: nameInput.value,
                    authorContact: contactInput.value,
                    body: bodyInput.value,
                    website: honeypot.value,
                    parentId: parentId,
                },
                function (err, result) {
                    if (err || !result.ok) {
                        replyStatus.textContent = (result && result.data && result.data.error) || 'Erro ao enviar.';
                        return;
                    }
                    if (result.data.status === 'approved' && result.data.comment) {
                        onPosted(result.data.comment);
                        wrap.remove();
                    } else {
                        replyStatus.textContent = 'Resposta enviada! Será exibida em breve.';
                        innerForm.reset();
                    }
                }
            );
        });

        return wrap;
    }

    function renderComment(c, opts) {
        opts = opts || {};
        var wrap = document.createElement('div');
        wrap.className = opts.isReply
            ? 'ml-6 sm:ml-10 mt-4 pl-4 border-l-2 border-outline-variant'
            : 'border-b border-outline-variant pb-4';

        var head = document.createElement('div');
        head.className = 'flex items-center flex-wrap gap-2 mb-1';
        var name = document.createElement('span');
        name.className = 'font-label-lg text-label-lg text-on-surface';
        name.textContent = c.authorName;
        head.appendChild(name);
        if (c.isAdmin) {
            var badge = document.createElement('span');
            badge.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-primary text-on-primary';
            badge.textContent = 'Equipe';
            head.appendChild(badge);
        }
        var date = document.createElement('span');
        date.className = 'font-body-md text-sm text-on-surface-variant';
        date.textContent = formatDate(c.createdAt);
        head.appendChild(date);

        var body = document.createElement('p');
        body.className = 'font-body-md text-body-md text-on-surface-variant';
        body.textContent = c.body;

        wrap.appendChild(head);
        wrap.appendChild(body);

        var repliesContainer = document.createElement('div');
        wrap.appendChild(repliesContainer);
        (opts.replies || []).forEach(function (r) {
            repliesContainer.appendChild(renderComment(r, { isReply: true }));
        });

        if (!opts.isReply) {
            var formSlot = document.createElement('div');
            var replyToggle = document.createElement('button');
            replyToggle.type = 'button';
            replyToggle.className = 'mt-2 font-label-lg text-sm text-primary hover:underline';
            replyToggle.textContent = 'Responder';
            replyToggle.addEventListener('click', function () {
                if (formSlot.firstChild) {
                    formSlot.innerHTML = '';
                    return;
                }
                formSlot.appendChild(
                    buildReplyForm(c.id, function (newComment) {
                        repliesContainer.appendChild(renderComment(newComment, { isReply: true }));
                    })
                );
            });
            wrap.appendChild(replyToggle);
            wrap.appendChild(formSlot);
        }

        return wrap;
    }

    function loadComments() {
        fetch(apiUrl)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                list.innerHTML = '';
                var comments = data.comments || [];
                var topLevel = comments.filter(function (c) { return !c.parentId; });
                var repliesByParent = {};
                comments.filter(function (c) { return c.parentId; }).forEach(function (c) {
                    if (!repliesByParent[c.parentId]) repliesByParent[c.parentId] = [];
                    repliesByParent[c.parentId].push(c);
                });

                if (topLevel.length === 0) {
                    var empty = document.createElement('p');
                    empty.className = 'font-body-md text-body-md text-on-surface-variant';
                    empty.textContent = 'Seja o primeiro a comentar.';
                    list.appendChild(empty);
                    return;
                }
                topLevel.forEach(function (c) {
                    list.appendChild(renderComment(c, { replies: repliesByParent[c.id] || [] }));
                });
            })
            .catch(function () {
                list.innerHTML = '';
                var err = document.createElement('p');
                err.className = 'font-body-md text-body-md text-on-surface-variant';
                err.textContent = 'Não foi possível carregar os comentários.';
                list.appendChild(err);
            });
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        status.textContent = 'Enviando...';
        var formData = new FormData(form);
        postComment(
            {
                authorName: formData.get('authorName'),
                authorContact: formData.get('authorContact'),
                body: formData.get('body'),
                website: formData.get('website'),
            },
            function (err, result) {
                if (err || !result.ok) {
                    status.textContent = (result && result.data && result.data.error) || 'Erro ao enviar comentário.';
                    return;
                }
                if (result.data.status === 'approved' && result.data.comment) {
                    if (list.querySelector('p')) list.innerHTML = '';
                    list.appendChild(renderComment(result.data.comment, { replies: [] }));
                    status.textContent = 'Comentário publicado!';
                } else {
                    status.textContent = 'Comentário enviado! Ele será exibido em breve.';
                }
                form.reset();
            }
        );
    });

    loadComments();
})();
</script>
</body>
</html>
