<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title><%= title %> - Administração</title>
<meta content="noindex" name="robots"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
    :root {
        --primary: #243f20;
        --primary-container: #3a5635;
        --secondary: #835500;
        --golden-orange: #DF9E3E;
        --tertiary: #75070c;
        --surface: #f9f9f9;
        --surface-container: #eeeeee;
        --surface-container-low: #f3f3f4;
        --on-surface: #1a1c1c;
        --on-surface-variant: #434840;
        --outline: #c3c8bd;
        --error: #ba1a1a;
        --error-container: #ffdad6;
        --success: #1a7a1a;
        --success-container: #d9f2d9;
    }
    * { box-sizing: border-box; }
    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: var(--surface);
        color: var(--on-surface);
        margin: 0;
        min-height: 100vh;
    }
    a { color: var(--primary); }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
    .admin-shell { max-width: 900px; margin: 0 auto; padding: 24px 20px 64px; }
    .admin-card { background: #fff; border: 1px solid var(--outline); border-radius: 12px; padding: 24px; margin-bottom: 24px; }
    h1 { font-size: 28px; color: var(--tertiary); margin: 0 0 8px; }
    h2 { font-size: 20px; color: var(--tertiary); margin: 0 0 16px; }
    p.hint { color: var(--on-surface-variant); margin-top: 0; }
    label { display: block; font-weight: 600; margin: 20px 0 6px; }
    label:first-child { margin-top: 0; }
    input[type=text], input[type=email], input[type=password], input[type=date], textarea, select {
        width: 100%; padding: 12px 14px; border: 2px solid var(--outline); border-radius: 8px;
        font-family: inherit; font-size: 16px; min-height: 48px;
    }
    textarea { min-height: 100px; resize: vertical; }
    input:focus, textarea:focus, select:focus { outline: 3px solid var(--golden-orange); border-color: var(--primary); }
    .field-hint { color: var(--on-surface-variant); font-size: 14px; margin-top: 4px; }
    .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 48px; padding: 0 20px; border-radius: 8px; font-weight: 600; font-size: 16px;
        border: 2px solid transparent; cursor: pointer; text-decoration: none;
    }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-container); }
    .btn-secondary { background: #fff; color: var(--primary); border-color: var(--primary); }
    .btn-secondary:hover { background: var(--surface-container-low); }
    .btn-danger { background: #fff; color: var(--error); border-color: var(--error); }
    .btn-danger:hover { background: var(--error-container); }
    .btn-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 700; }
    .badge-published { background: var(--success-container); color: var(--success); }
    .badge-draft { background: #fde9c8; color: var(--secondary); }
    .flash { padding: 14px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; }
    .flash-success { background: var(--success-container); color: var(--success); }
    .flash-error { background: var(--error-container); color: var(--error); }
    .list-item { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 16px; padding: 16px; border: 1px solid var(--outline); border-radius: 10px; margin-bottom: 12px; background: #fff; }
    .list-item-info { display: flex; align-items: center; gap: 16px; flex: 1 1 200px; min-width: 0; }
    .list-item-text { min-width: 0; }
    .list-item-title { font-weight: 700; overflow-wrap: anywhere; }
    .list-item-meta { color: var(--on-surface-variant); font-size: 14px; overflow-wrap: anywhere; }
    .list-item-actions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .thumb { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 1px solid var(--outline); flex-shrink: 0; }
    .grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
    .dash-card { display: block; background: #fff; border: 1px solid var(--outline); border-radius: 12px; padding: 20px; text-decoration: none; color: var(--on-surface); }
    .dash-card:hover { border-color: var(--primary); }
    .dash-card .material-symbols-outlined { font-size: 32px; color: var(--primary); }
    .dash-card h3 { margin: 12px 0 4px; font-size: 18px; color: var(--tertiary); }
    .dash-card p { margin: 0; color: var(--on-surface-variant); font-size: 14px; }
    .upload-preview { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 8px; }
    .upload-preview img { max-width: 160px; max-height: 120px; border-radius: 8px; border: 1px solid var(--outline); object-fit: cover; }
    .upload-preview > div { min-width: 0; flex: 1 1 200px; }
    .upload-preview input[type=file] { max-width: 100%; }
    .steps-list { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
    .steps-list input { flex: 1; }
    .step-row { display: flex; gap: 8px; align-items: center; }
    .reorder-controls { display: flex; flex-direction: column; gap: 2px; }
    .reorder-controls button { background: none; border: 1px solid var(--outline); border-radius: 6px; width: 32px; height: 28px; cursor: pointer; }
    .password-field { position: relative; }
    .password-field input { padding-right: 48px; }
    .password-toggle-btn { position: absolute; top: 0; right: 0; width: 48px; height: 48px; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--on-surface-variant); }
</style>
<script>window.__CSRF_TOKEN__ = <%- JSON.stringify(csrfToken) %>;</script>
<script src="/admin/static/admin.js" defer></script>
