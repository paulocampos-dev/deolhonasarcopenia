<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('partials/head', { title: 'Entrar' }) %>
</head>
<body>
<div style="max-width: 420px; margin: 80px auto; padding: 0 20px;">
<div class="admin-card">
<h1 style="text-align:center;">De Olho Na Sarcopenia</h1>
<p class="hint" style="text-align:center;">Área administrativa</p>
<% if (error) { %>
<div class="flash flash-error"><%= error %></div>
<% } %>
<form action="/admin/login" method="POST">
<input name="_csrf" type="hidden" value="<%= csrfToken %>"/>
<label for="username">Usuário</label>
<input autocomplete="username" id="username" name="username" required type="text"/>
<label for="password">Senha</label>
<input autocomplete="current-password" id="password" name="password" required type="password"/>
<div class="btn-row">
<button class="btn btn-primary" style="width: 100%;" type="submit">Entrar</button>
</div>
</form>
</div>
</div>
</body>
</html>
